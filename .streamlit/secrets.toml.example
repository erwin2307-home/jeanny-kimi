# --- Streamlit Cloud side (paste into Cloud: App -> Settings -> Secrets) ---
API_URL = "https://xxxx.trycloudflare.com"
API_KEY = "same value as JARVIS_REMOTE_API_KEY on your local machine"

# --- Local backend side (this file, on YOUR machine only — never upload
# this part to Streamlit Cloud Secrets, DeepSeek/Groq keys are not needed
# there; the local backend reads them straight from this file) ---
# DEEPSEEK_API_KEY = "sk-..."
# GROQ_API_KEY = "gsk_..."
